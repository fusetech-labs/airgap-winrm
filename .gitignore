# The Patch Palace - things that must never go into the repository

# Patch files are 500 MB+ and are downloaded from the Microsoft Update Catalog, not stored here
patches/**/*.msu
patches/**/*.cab
patches/**/*.exe
patches/**/*.msp
patches/**/*.iso
patches/**/*.zip
patches/_info/

# Logs contain server names and operator identities
logs/

# References are for internal use only and contain sensitive information 
references/

# Server lists are site-specific; commit only the placeholder samples
# (remove the next three lines if you DO want your real lists in the repo)
PatchGroup-*.txt
!PatchGroup-A.txt
!PatchGroup-B.txt
!PatchGroup-C.txt

# Reports contain host names, account names and findings
reports/

# Saved results (one file per server: every collector's last result), the copy written for a server without WinRM
# and the spoke's settings: host names, account names, findings, site paths
state/

# Code-signing requests made on the About tab name your organisation and this PC
signing/

# SOE standards and the security profile / tailoring describe YOUR environment and risk decisions.
# Remove these two lines if you want them versioned in a private repository.
soe/*.json
security/*.json
# what the Settings tab saved: your products, change system and rules
settings/*.json
settings/*.part

# Development only (the IDE): the build and test scripts are not part of the published tool
Build-*.ps1
tests/
# the capability brief (brochure.html and the PDF built from it)
brochure/

# The Download Toolkit (companion\) stays out of this version's repository - it is picked up in a later version;
# the manifest and checksums it writes beside the WinRM toolkit's patches\ and software\ stay out too
companion/
library-manifest.json
library-manifest.json.part
CHECKSUMS.txt

# Editor / OS noise
Thumbs.db
desktop.ini
*.swp
.vscode/
CODE-REVIEW.md
ROADMAP.md

# change records (server names, ticket numbers) and software installers
changes/
software/**/*.exe
software/**/*.msi
software/**/*.msp
software/**/*.zip
software/_info/
